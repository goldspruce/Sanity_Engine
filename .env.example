# Gemini API Configuration
GEMINI_API_KEY="your-gemini-api-key-here"
GEMINI_MODEL="gemini-3.8-flash"  # or gemini-3.5-flash

# Optional Cross-Family Critic (Anthropic Claude)
ANTHROPIC_API_KEY="your-anthropic-api-key-here"
ANTHROPIC_MODEL="claude-3-5-sonnet-latest"

# Optional Shareable Google NotebookLM Link (Preloaded with textbook corpus)
NOTEBOOKLM_URL="https://notebooklm.google.com/notebook/your-shared-notebook-id"

